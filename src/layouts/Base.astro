---
/*
  Base.astro — the shell every page renders inside.

  Owns the <head>, the skip link, and the header/footer. Pages supply only
  their own <main> content. The stylesheet is imported here once, so no page
  can render without the design tokens.

  Accessibility baked in at this level: a skip link as the first focusable
  element, a single <main id="content">, lang on <html>, and a per-page title
  and description.
*/
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import contours from '../assets/images/bridger-contours.svg';

interface Props {
	/** Page title, without the site name. */
	title: string;
	/** Meta description. TODO-marked strings are fine pre-launch. */
	description?: string;
	/**
	 * Per-page share image (added 2026-07-30). Pages that own a strong
	 * visual pass an absolute URL plus its alt text; everything else falls
	 * back to the sitewide name card. A project page sharing its own cover
	 * previews as that project rather than as a generic card.
	 */
	shareImageUrl?: string;
	shareImageAlt?: string;
	/**
	 * Extra JSON-LD to emit alongside the sitewide Person block. Project
	 * pages pass a CreativeWork describing the case study.
	 */
	structuredData?: Record<string, unknown>;
}

const {
	title,
	description,
	shareImageUrl,
	shareImageAlt,
	structuredData,
} = Astro.props;

/*
  Absolute URLs for og:url/og:image, built from `site` in astro.config.mjs
  (https://jacksoncrose.github.io). The share image is a static file in
  public/ (NOT src/assets) so its URL never changes between builds — link
  scrapers cache og images aggressively, and a hashed _astro/ filename
  would break old shares on every deploy. Card settled with Jackson
  2026-07-29: name + identity line over the western half of the
  federal-land choropleth ("C — name card", chosen over an estimator
  interface crop and a portrait band after seeing all three as rendered
  link previews).
*/
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const defaultShareImage = new URL('/share-card.png', Astro.site);
const defaultShareAlt =
	'Jackson Rose — rural places, energy and natural resource policy, and especially making maps. Text beside a county-level map of federal land in the western United States.';

/* Per-page override falls back to the sitewide card. Dimensions are only
   declared for the default card, whose 1200×630 is known; a project cover
   has its own aspect ratio and lying about it makes previews crop wrong. */
const shareImage = shareImageUrl ?? defaultShareImage.toString();
const shareAlt = shareImageAlt ?? defaultShareAlt;
const isDefaultShareImage = shareImage === defaultShareImage.toString();

/*
  Sitewide JSON-LD (added 2026-07-30). Every claim here is already stated
  in prose somewhere on the site and traces to site.ts or the About page —
  nothing is asserted to search engines that a reader cannot verify on the
  page. No sameAs array: no social or profile URLs have been confirmed, and
  guessing at them is exactly the kind of invention this project forbids.
*/
const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: new URL('/', Astro.site).toString(),
	jobTitle: [
		'Assistant Director and Operations Manager, MSU Geospatial Core Facility',
		'Instructor, Earth Sciences, Montana State University',
	],
	worksFor: {
		'@type': 'CollegeOrUniversity',
		name: 'Montana State University',
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Bozeman',
		addressRegion: 'MT',
		addressCountry: 'US',
	},
	...(site.email ? { email: `mailto:${site.email}` } : {}),
	knowsAbout: [
		'Community benefits agreements',
		'Geographic information systems',
		'Spatial analysis',
		'UAS and LiDAR survey',
		'Energy and natural resource policy',
		'Rural community development',
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{/* noindex removed 2026-07-29 — Jackson's launch call. The site is public. */}
		<title>{title} — {site.name}</title>
		{description && <meta name="description" content={description} />}

		{/*
		  Open Graph and Twitter card tags. These control what appears when the
		  URL is pasted into Slack, LinkedIn, iMessage, or email. Without them a
		  shared link renders as a bare URL, which for a portfolio being sent to
		  a prospective employer is a wasted first impression.
		*/}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={`${title} — ${site.name}`} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImage} />
		{
			isDefaultShareImage && (
				<>
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}
		<meta property="og:image:alt" content={shareAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={shareImage} />
		<meta name="twitter:image:alt" content={shareAlt} />

		{/*
		  Structured data. The Person block ships on every page; pages that
		  pass `structuredData` add a second block describing themselves.
		  set:html is safe here because both objects are built in this
		  codebase from typed content, never from user input.
		*/}
		<script
			type="application/ld+json"
			set:html={JSON.stringify(personLd)}
		/>
		{
			structuredData && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(structuredData)}
				/>
			)
		}
	</head>

	<body class="min-h-screen">
		<a
			href="#content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:bg-white focus:px-3 focus:py-2 focus:text-ink"
		>
			Skip to content
		</a>

		{/*
		  ---------- contour background ----------
		  Settled with Jackson 2026-07-30 (rendered mockups, his pick of five
		  options), extended from Home-only to EVERY page later the same day
		  (his call). Faint topographic contours behind the header and the top
		  of each page, fading to plain paper before long-form content. The
		  linework is REAL terrain, cut from the USGS 1/3 arc-second DEM he
		  supplied (tile n46w111): the Bridger Range, lat 45.80–45.98, lon
		  −111.00–−110.75, 50 m interval with 250 m index contours — the
		  crop's high point is Sacagawea Peak. Regenerate with
		  scripts/make-contour-background.py; the SVG is 84 KB raw / ~35 KB
		  gzipped, ink-colored strokes, no JavaScript.

		  Tuning knobs: overall strength is the wrapper's opacity-[0.12]
		  (effective ~5% regular / ~8% index lines against paper); the fade is
		  the mask-image gradient; the band height is h-[64rem]. Decorative
		  only — aria-hidden, empty alt, fetchpriority low so it never
		  competes with page content.
		*/}
		<div
			aria-hidden="true"
			class="absolute inset-x-0 top-0 -z-10 h-[64rem] overflow-hidden opacity-[0.12] [-webkit-mask-image:linear-gradient(to_bottom,black_55%,transparent_100%)] [mask-image:linear-gradient(to_bottom,black_55%,transparent_100%)]"
		>
			<img
				src={contours.src}
				alt=""
				class="h-full w-full object-cover"
				decoding="async"
				fetchpriority="low"
			/>
		</div>

		<Header />

		<main id="content" class="mx-auto max-w-3xl px-6 py-12">
			<slot />
		</main>

		<Footer />
	</body>
</html>

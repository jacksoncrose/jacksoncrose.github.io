---
/*
  Base.astro — the shell every page renders inside.

  Owns the <head>, the skip link, and the header/footer. Pages supply only
  their own <main> content. The stylesheet is imported here once, so no page
  can render without the design tokens.

  Accessibility baked in at this level: a skip link as the first focusable
  element, a single <main id="content">, lang on <html>, and a per-page title
  and description.
*/
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
	/** Page title, without the site name. */
	title: string;
	/** Meta description. TODO-marked strings are fine pre-launch. */
	description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{/*
		  PRE-LAUNCH ONLY: keeps search engines from indexing the site while
		  content is incomplete (AGENTS.md, step 6). Remove this line at launch.
		*/}
		<meta name="robots" content="noindex" />
		<title>{title} — {site.name}</title>
		{description && <meta name="description" content={description} />}

		{/*
		  Open Graph and Twitter card tags. These control what appears when the
		  URL is pasted into Slack, LinkedIn, iMessage, or email. Without them a
		  shared link renders as a bare URL, which for a portfolio being sent to
		  a prospective employer is a wasted first impression.

		  og:url and og:image are deliberately absent: both need absolute URLs,
		  which need the deployed domain set as `site` in astro.config.mjs. Add
		  them at deploy (step 6), along with a share image.
		*/}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={`${title} — ${site.name}`} />
		{description && <meta property="og:description" content={description} />}
		<meta name="twitter:card" content="summary_large_image" />
	</head>

	<body class="min-h-screen">
		<a
			href="#content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:bg-white focus:px-3 focus:py-2 focus:text-ink"
		>
			Skip to content
		</a>

		<Header />

		<main id="content" class="mx-auto max-w-3xl px-6 py-12">
			<slot />
		</main>

		<Footer />
	</body>
</html>

---
/*
  Header.astro — sitewide masthead: name (home link), section nav, contact.

  There is no Contact page by design (AGENTS.md sitemap), so the email lives
  here and in the footer on every page. No JavaScript: the nav is a plain
  list that wraps on small screens rather than collapsing into a menu button.
*/
import { site, nav } from '../site';

const path = Astro.url.pathname;
/** Mark the current section for both sighted users and screen readers. */
const isCurrent = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-line">
	<div
		class="mx-auto flex max-w-3xl flex-wrap items-baseline gap-x-6 gap-y-2 px-6 py-5"
	>
		<a
			href="/"
			class="font-serif text-xl font-semibold text-ink no-underline"
		>
			{site.name}
		</a>

		<nav aria-label="Sections" class="flex flex-wrap gap-x-5 gap-y-1">
			{
				nav.map((item) => (
					<a
						href={item.href}
						aria-current={isCurrent(item.href) ? 'page' : undefined}
						class:list={[
							'text-sm no-underline hover:underline',
							isCurrent(item.href)
								? 'font-semibold text-accent underline'
								: 'text-ink',
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto text-sm">
			{
				site.email ? (
					<a href={`mailto:${site.email}`}>{site.email}</a>
				) : (
					<span class="text-accent">TODO: contact email</span>
				)
			}
		</div>
	</div>
</header>

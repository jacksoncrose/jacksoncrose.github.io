---
/*
  About — bio, the community-organizing to research-faculty arc, teaching
  (two lines), CV as PDF, one-line consulting mention (RCRC). Per the sitemap.

  The arc is Jackson's own history: every date, title, and organization here
  comes from him, not from inference.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { site } from '../site';
---

<Base title="About" description="TODO: meta description for About.">
	<h1 class="text-4xl">About</h1>
	<p class="mt-3 text-sm text-muted">{site.roles}</p>

	<section class="mt-10">
		<h2 class="text-3xl">Bio</h2>
		<Todo note="Two or three paragraphs. Written with Jackson." />
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Background</h2>
		<Todo note="The community-organizing to research-faculty arc. Executive Director tenure dates are unconfirmed — needed before this can be written." />
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Teaching</h2>
		<Todo note="Two lines. Which courses, and at what level." />
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">CV</h2>
		<Todo note="CV as a PDF in /public, plus the date it was last updated." />
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Consulting</h2>
		<Todo note="One line on consulting through Resources and Communities Research & Consulting (RCRC). Confirm how the relationship should be described." />
	</section>
</Base>

---
/*
  Project detail pages.

  FIXES A LATENT BUG: both the Projects index and Home link to
  /projects/<id> whenever an entry has hasPage: true, but no route existed to
  serve those URLs. Nothing 404s today only because every project is still a
  draft and therefore filtered out. The first entry to go live would have
  shipped a broken link.

  Only non-draft entries with hasPage get a page. A tier-3 card that links
  nowhere is intentional.
*/
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Todo from '../../components/Todo.astro';
import StatBand from '../../components/StatBand.astro';
import { published, clientLabel, yearLabel } from '../../lib/content';
import { site } from '../../site';

export async function getStaticPaths() {
	const projects = published(await getCollection('projects'));
	return projects
		.filter((project) => project.data.hasPage)
		.map((project) => ({
			params: { slug: project.id },
			props: { project },
		}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const client = clientLabel(project.data);
const meta = [yearLabel(project.data), project.data.role, client]
	.filter(Boolean)
	.join(' · ');

/*
  Per-page share image (2026-07-30). A project with a cover previews as
  that project when its URL is pasted into email or Slack, instead of as
  the generic name card. Absolute URL, because og:image requires one.

  format: 'jpeg' is deliberate and NOT the site's usual WebP. Astro serves
  WebP to browsers because every browser supports it, but link scrapers are
  a different audience: several — LinkedIn among them — still fail to
  render WebP og:images, which would silently produce a preview with no
  picture at all. JPEG is universally understood and small.

  KNOWN TRADEOFF with the note above about share-card.png living in
  public/: this URL *is* a hashed _astro/ filename, the thing that comment
  warns against. Accepted because Astro's hash is content-derived, so it
  only moves when the cover image itself changes, and the failure mode is
  one old shared link losing its thumbnail rather than a broken page. The
  sitewide card keeps its permanent public/ URL precisely because it is the
  one that must never break.

  Projects without a cover (the MCSC and Salmon Valley case studies) fall
  back to the sitewide card, which Base handles.
*/
const coverShare = project.data.cover
	? await getImage({
			src: project.data.cover.src,
			width: 1200,
			format: 'jpeg',
			quality: 82,
		})
	: null;
const shareImageUrl = coverShare
	? new URL(coverShare.src, Astro.site).toString()
	: undefined;

/*
  Full-size cover for the click-to-enlarge link (2026-08-15, his call in
  the site-wide sweep). Native width, no upscaling — the same derivative
  the Maps lightbox and SheetFigure use.
*/
const coverFull = project.data.cover
	? await getImage({ src: project.data.cover.src, width: project.data.cover.src.width })
	: null;

/*
  CreativeWork rather than Article: these are case studies about projects,
  not published articles, and Article would want a publication date this
  content does not have. Only fields backed by the entry's own frontmatter
  are emitted — no invented dates, no invented publisher.
*/
const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.data.title,
	description: project.data.summary,
	url: new URL(Astro.url.pathname, Astro.site).toString(),
	author: { '@type': 'Person', name: site.name },
	...(project.data.year ? { dateCreated: String(project.data.year) } : {}),
	...(shareImageUrl ? { image: shareImageUrl } : {}),
	...(client ? { sourceOrganization: { '@type': 'Organization', name: client } } : {}),
};
---

<Base
	title={project.data.title}
	description={project.data.summary}
	shareImageUrl={shareImageUrl}
	shareImageAlt={project.data.cover?.alt}
	structuredData={projectLd}
>
	<article>
		<h1 class="text-4xl">{project.data.title}</h1>

		{meta && <p class="mt-3 text-sm text-muted">{meta}</p>}

		{
			project.data.tools && (
				<p class="mt-2 text-sm text-muted">{project.data.tools.join(', ')}</p>
			)
		}

		<p class="mt-6 text-lg">{project.data.summary}</p>

		{project.data.stats && <StatBand stats={project.data.stats} />}

		{
			project.data.links.length > 0 && (
				<ul class="mt-4 space-y-1 text-sm">
					{project.data.links.map((l) => (
						<li>
							<a href={l.url}>{l.label}</a>
						</li>
					))}
				</ul>
			)
		}

		{
			/* Through Astro's asset pipeline like the gallery: responsive WebP,
			   explicit dimensions, no client-side JS. The raw <img> this replaced
			   would have shipped the full committed derivative to every visitor. */
			project.data.cover && coverFull && (
				<figure class="mt-8">
					{/* HEIGHT CAP + CLICK-TO-ENLARGE (2026-08-15, his call in the
					    site-wide sweep). Tall covers — the estimator's Arizona map
					    at 0.85 renders 847px tall at the 45rem column — pushed the
					    first paragraph below a 900px fold. The cover is now capped
					    at 70vh and sized by height (w-auto, centered), so landscape
					    covers are unchanged and tall ones shrink to keep text on
					    screen. NOT object-contain on a w-full box: that would paint
					    white letterbox bars against the paper background. The
					    anchor carries data-lightbox so the sheet dialog below
					    upgrades the click; with JS off it opens the full derivative. */}
					<a
						href={coverFull.src}
						data-lightbox
						data-alt={project.data.cover.alt}
						aria-label="Open the full-size cover image"
						class="block"
					>
						<Image
							src={project.data.cover.src}
							alt={project.data.cover.alt}
							widths={[768, 1200, 1600]}
							sizes="(min-width: 816px) 45rem, calc(100vw - 3rem)"
							class="mx-auto h-auto max-h-[70vh] w-auto max-w-full border border-line bg-white"
						/>
					</a>
					{/* Caption and credit (2026-07-30). A cover that is someone
					    else's photograph has to be able to carry attribution
					    here, or moving an image from the body to the cover
					    quietly drops the credit it was licensed under. */}
					{(project.data.cover.caption || project.data.cover.photoCredit) && (
						<figcaption class="mt-3 text-sm text-muted">
							{project.data.cover.caption}
							{project.data.cover.photoCredit && (
								<>
									{project.data.cover.caption ? ' ' : ''}
									Photo courtesy of{' '}
									{project.data.cover.photoCredit.url ? (
										<a href={project.data.cover.photoCredit.url}>
											{project.data.cover.photoCredit.name}
										</a>
									) : (
										project.data.cover.photoCredit.name
									)}
									.
								</>
							)}
						</figcaption>
					)}
				</figure>
			)
		}

		{/*
		  Case-study body. The required shape is problem, approach, what was
		  delivered, outcome — enforced by review, not by the schema, since
		  Markdown bodies are free-form.
		*/}
		<div class="mt-8 space-y-4 text-base">
			<Content />
		</div>

		<p class="mt-12 border-t border-line pt-6 text-sm">
			<a href="/projects">All projects</a>
		</p>
	</article>

	{/*
	  Sheet lightbox (2026-08-03). SheetFigure's image is a real <a> to the
	  full derivative; this dialog upgrades that click into an in-page
	  enlargement, same progressive-enhancement bargain as the Maps page.
	  It differs from the Maps lightbox in one way that matters for the
	  Campus at Night sheets: those are 2400px portrait DOCUMENTS, and
	  object-contain inside the viewport would render their footer type
	  unreadably small — the opposite of what opening them is for. So the
	  dialog SCROLLS instead: the image stays at its natural size and the
	  dialog pans over it, which is the zoom. The close button is sticky so
	  it stays reachable while scrolled; Esc and backdrop click also close.
	  Pages without a data-lightbox link ship the markup unused and the
	  script finds nothing to wire — a few hundred bytes, no behaviour.
	*/}
	<dialog
		id="sheet-lightbox"
		aria-label="Enlarged figure"
		class="m-auto max-h-[92vh] max-w-[94vw] overflow-auto bg-transparent p-0 backdrop:bg-ink/85"
	>
		<button
			id="sheet-lightbox-close"
			type="button"
			aria-label="Close enlarged figure"
			class="sticky top-2 float-right mr-2 flex h-10 w-10 items-center justify-center bg-white text-2xl leading-none text-ink"
		>
			×
		</button>
		<img
			id="sheet-lightbox-img"
			src=""
			alt=""
			class="max-w-none border border-line bg-white"
		/>
	</dialog>

	<script>
		const dialog = document.getElementById(
			'sheet-lightbox',
		) as HTMLDialogElement;
		const img = document.getElementById(
			'sheet-lightbox-img',
		) as HTMLImageElement;
		const closeBtn = document.getElementById('sheet-lightbox-close')!;

		document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach(
			(link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					img.src = link.href;
					img.alt = link.dataset.alt ?? '';
					dialog.showModal();
					dialog.scrollTop = 0;
				});
			},
		);

		closeBtn.addEventListener('click', () => dialog.close());

		/* Click on the backdrop (the dialog element itself, outside the
		   image and button) closes. Esc is handled natively. */
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		/* Drop the src on close so a slow-loading image never flashes
		   stale content on the next open. */
		dialog.addEventListener('close', () => {
			img.src = '';
			img.alt = '';
		});
	</script>
</Base>

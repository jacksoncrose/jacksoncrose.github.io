---
/*
  Maps — visual gallery: image, title, 1-2 sentences, year, tools.
  No case-study prose (sitemap).

  Each image renders through Astro's <Image>, which generates responsive
  sizes from the derivative in src/assets/images/ at build time — plain
  <img> output. The first two images load eagerly because they sit above
  the fold; the rest lazy-load.

  LIGHTBOX added 2026-07-30 (Jackson: clicking a map should open a
  higher-res bigger version). Progressive enhancement, so the site's
  no-unnecessary-JS rule bends but doesn't break:
  - Every thumbnail is a REAL <a> to the full-size derivative (built via
    getImage at each original's native width, no upscaling). With JS off,
    the click simply opens the image.
  - ~25 lines of inline script upgrade the click into a native <dialog>
    lightbox: Esc, focus handling, and scroll-lock come from the browser's
    showModal(), not from a library. Backdrop click closes (the dialog
    itself is the click target only when the click lands outside the
    figure). No dependencies.

  GROUPED SETS added 2026-07-31, from Jackson: "It needs to be clear that
  the poster and ranch division maps are all the same project/client."

  The page is a vertical stack of blocks rather than one flat grid. A block
  is either a run of ungrouped entries or a group: a heading, a note naming
  the client, a link to the project page, and the group's own items.
  `galleryBlocks()` builds the stack; `published()` remains the only sort
  authority for where blocks land, with `groupOrder` sorting only within a
  group.

  COMPARISONS AND A CAROUSEL added 2026-08-01, from Jackson: "Can we make
  the map gallery have cooler visuals? Like a swipe gallery for Rooney Ranch
  and a swipe tool to compare closure scenarios for schools." His call was
  both, not either.

  Two entries sharing a `pair` id now render as ONE wipe comparison
  (MapCompare), and a group can ask to be a carousel. Everything about
  choosing the layout moved into GalleryItems, so this page no longer
  carries two near-identical copies of the card list. The lightbox script
  below is unchanged and still picks up every `a[data-lightbox]`, including
  the two "View larger" links a comparison renders.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import GalleryItems from '../components/GalleryItems.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { published, galleryBlocks } from '../lib/content';

const gallery = published(await getCollection('gallery'));

/** Full-size derivative per entry for the lightbox / no-JS link target. */
const fullById = new Map(
	await Promise.all(
		gallery.map(
			async (entry) =>
				[
					entry.id,
					await getImage({
						src: entry.data.image,
						width: entry.data.image.width,
					}),
				] as const,
		),
	),
);

const blocks = galleryBlocks(gallery);

/*
  Eager-load the first two images on the page. The flat grid could read
  this off the map index; with blocks, position has to be tracked across
  them, so it is resolved once here by entry id.
*/
const eagerIds = new Set(gallery.slice(0, 2).map((entry) => entry.id));
---

<Base title="Maps" description="Selected maps by Jackson Rose: national land ownership choropleths, custom-hillshade ranch maps, an overnight UAV orthomosaic of the MSU campus, a biocultural region map spanning two countries, and a school-access comparison for rural Montana.">
	<h1 class="text-4xl">Maps</h1>
	{/* Intro is Jackson's own wording, verbatim (2026-07-29). Do not rewrite. */}
	<p class="mt-6 text-lg">
		Maps from client and research projects, and some just for the sake of
		mapping.
	</p>

	{
		gallery.length === 0 ? (
			<Todo note="Gallery inventory is unconfirmed: which maps, figures, and orthomosaic stills go here, and in what order. Images and real alt text needed for each." />
		) : (
			blocks.map((block, blockIndex) =>
				block.kind === 'run' ? (
					<GalleryItems
						items={block.items}
						hasPair={block.hasPair}
						fullById={fullById}
						eagerIds={eagerIds}
						class={blockIndex === 0 ? 'mt-8' : 'mt-16'}
					/>
				) : (
					<section
						class="mt-16 border-t border-line pt-8"
						aria-labelledby={`gallery-group-${block.id}`}
					>
						<h2 id={`gallery-group-${block.id}`} class="text-3xl">
							{block.meta.title}
						</h2>
						<p class="mt-3 text-base">{block.meta.note}</p>
						{block.meta.href && (
							<p class="mt-2 text-sm">
								<a href={block.meta.href}>Read the project</a>
							</p>
						)}
						<GalleryItems
							items={block.items}
							hasPair={block.hasPair}
							carousel={block.meta.carousel}
							label={`${block.meta.title}: ${block.items.length} sheets`}
							fullById={fullById}
							eagerIds={eagerIds}
							headingLevel={3}
							class="mt-8"
						/>
					</section>
				),
			)
		)
	}

	{/* The lightbox itself. Hidden until showModal(); empty src is never
	    visible because the dialog only opens after src is set. */}
	<dialog
		id="map-lightbox"
		aria-label="Enlarged map"
		class="m-auto max-h-none max-w-none bg-transparent p-4 backdrop:bg-ink/85 sm:p-8"
	>
		<button
			id="map-lightbox-close"
			type="button"
			aria-label="Close enlarged map"
			class="absolute top-2 right-2 flex h-10 w-10 items-center justify-center bg-white text-2xl leading-none text-ink"
		>
			×
		</button>
		<img
			id="map-lightbox-img"
			src=""
			alt=""
			class="max-h-[88vh] max-w-[92vw] border border-line bg-white object-contain"
		/>
	</dialog>

	<script>
		const dialog = document.getElementById(
			'map-lightbox',
		) as HTMLDialogElement;
		const img = document.getElementById(
			'map-lightbox-img',
		) as HTMLImageElement;
		const closeBtn = document.getElementById('map-lightbox-close')!;

		document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach(
			(link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					img.src = link.href;
					img.alt = link.dataset.alt ?? '';
					dialog.showModal();
				});
			},
		);

		closeBtn.addEventListener('click', () => dialog.close());

		/* Click on the backdrop (the dialog element itself, outside the
		   image and button) closes. Esc is handled natively. */
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		/* Drop the src on close so a slow-loading image never flashes
		   stale content on the next open. */
		dialog.addEventListener('close', () => {
			img.src = '';
			img.alt = '';
		});
	</script>
</Base>

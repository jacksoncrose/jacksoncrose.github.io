---
/*
  Projects — index of cards, grouped by tier (sitemap). Tier 1 is the spine and
  leads; tier 2 gets full pages; tier 3 are cards only.

  Client names pass through clientLabel(), the single gate that refuses to
  print a name whose permission is not confirmed.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { getCollection } from 'astro:content';
import { published, clientLabel, cardTarget } from '../lib/content';

const projects = published(await getCollection('projects'));

/*
  Tier headings settled with Jackson 2026-07-29 (replacing the working
  titles): tier 1 "Fiscal analysis and community policy" (covers both the
  estimator and the MCSC negotiation), tier 2 "Applied research" (his pick
  from nine options; holds the disbursements report and the land ownership
  dataset), tier 3 "Other work" (kept as was). Intro below is his pick,
  "shortest" of three drafts, approved verbatim.
*/
const tiers = [
	{ tier: 1 as const, heading: 'Fiscal analysis and community policy' },
	{ tier: 2 as const, heading: 'Applied research' },
	{ tier: 3 as const, heading: 'Other work' },
];
---

<Base title="Projects" description="Case studies of Jackson Rose's work: a renewable energy revenue estimator, a national land ownership analysis, a community benefits agreement negotiation, and mapping work across Montana.">
	<h1 class="text-4xl">Projects</h1>
	<p class="mt-6 text-lg">
		Selected client and research work. The case studies describe the problem,
		the approach, and what was delivered; client names appear where I have
		permission to use them.
	</p>

	{
		projects.length === 0 && (
			<Todo note="No published projects yet. Drafts exist but stay hidden until their unconfirmed facts (dates, clients, metrics) are filled in." />
		)
	}

	{
		tiers.map(({ tier, heading }) => {
			const inTier = projects.filter((p) => p.data.tier === tier);
			if (inTier.length === 0) return null;
			return (
				<section class="mt-12 border-t border-line pt-8">
					<h2 class="text-3xl">{heading}</h2>
					<ul class="mt-6 space-y-8">
						{inTier.map((project) => {
							const client = clientLabel(project.data);
							/* Card-only entries link to their first link when they have
							   one (2026-07-30) — see cardTarget in lib/content. */
							const target = cardTarget(project.data, project.id);
							return (
								<li>
									<h3 class="text-xl">
										{target ? (
											<a href={target.href}>{project.data.title}</a>
										) : (
											project.data.title
										)}
									</h3>
									<p class="mt-1 text-sm text-muted">
										{[
											project.data.year?.toString(),
											project.data.role,
											client,
											target?.external ? 'Live tool' : null,
										]
											.filter(Boolean)
											.join(' · ')}
									</p>
									<p class="mt-2 text-base">{project.data.summary}</p>
									{project.data.tools && (
										<p class="mt-2 text-sm text-muted">
											{project.data.tools.join(', ')}
										</p>
									)}
								</li>
							);
						})}
					</ul>
				</section>
			);
		})
	}
</Base>

---
/*
  Projects — index of cards, grouped by tier (sitemap). Tier 1 is the spine and
  leads; tier 2 gets full pages; tier 3 are cards only.

  Client names pass through clientLabel(), the single gate that refuses to
  print a name whose permission is not confirmed.

  IMAGES ADDED 2026-07-31. This page was the only content page on the site
  with no imagery: nine entries, 2,600 px of unbroken prose, on the first nav
  item and the page the brief says a skimming reader is most likely to open.
  Every entry already had a cover. The card is the SAME shape as the Home
  tools strip, Home selected projects, and the Tools page — see the
  one-card-shape rule in AGENTS.md. Change it here and change it there.

  cover.fit is honoured, so a self-contained figure (the land ownership map)
  is contained rather than cropped through its own title and caption.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import CardCover from '../components/CardCover.astro';
import { getCollection } from 'astro:content';
import { published, listed, clientLabel, cardTarget } from '../lib/content';

/*
  `listed()` is what keeps tool-backed personal work off this index.
  Added 2026-08-01, from Jackson: "Tools (MT Hall and FFD) are showing up
  in projects. That's redundant." Montana Hall's case study still builds at
  /projects/montana-hall and is reached from its Tools card; the Frost-Free
  Days projects entry was removed outright, since it was a card-only entry
  pointing at the same live tool the Tools card points at.
*/
const projects = listed(published(await getCollection('projects')));

/*
  Tier headings settled with Jackson 2026-07-29 (replacing the working
  titles): tier 1 "Fiscal analysis and community policy" (covers both the
  estimator and the MCSC negotiation), tier 2 "Applied research" (his pick
  from nine options; holds the disbursements report and the land ownership
  dataset), tier 3 "Other work" (kept as was). Intro below is his pick,
  "shortest" of three drafts, approved verbatim.
*/
const tiers = [
	{ tier: 1 as const, heading: 'Fiscal analysis and community policy' },
	{ tier: 2 as const, heading: 'Applied research' },
	{ tier: 3 as const, heading: 'Other work' },
];

---

<Base title="Projects" description="Case studies of Jackson Rose's work: a renewable energy revenue estimator, a national land ownership analysis, a community benefits agreement negotiation, and mapping work across Montana.">
	<h1 class="text-4xl">Projects</h1>
	<p class="mt-6 text-lg">
		Selected client and research work. The case studies describe the problem,
		the approach, and what was delivered; client names appear where I have
		permission to use them.
	</p>

	{
		projects.length === 0 && (
			<Todo note="No published projects yet. Drafts exist but stay hidden until their unconfirmed facts (dates, clients, metrics) are filled in." />
		)
	}

	{
		tiers.map(({ tier, heading }) => {
			const inTier = projects.filter((p) => p.data.tier === tier);
			if (inTier.length === 0) return null;
			return (
				<section class="mt-12 border-t border-line pt-8">
					<h2 class="text-3xl">{heading}</h2>
					<ul class="mt-6 grid list-none gap-5 p-0">
						{inTier.map((project) => {
							const client = clientLabel(project.data);
							/* Card-only entries link to their first link when they have
							   one (2026-07-30) — see cardTarget in lib/content. */
							const target = cardTarget(project.data, project.id);
							return (
								<li class="relative border border-line bg-white transition-colors focus-within:border-accent hover:border-accent sm:flex">
									{project.data.cover && (
										<CardCover
											src={project.data.cover.src}
											alt={project.data.cover.alt}
											fit={project.data.cover.fit}
										/>
									)}
									<div class="p-5">
										<h3 class="text-xl">
											{target ? (
												<a href={target.href} class="after:absolute after:inset-0">
													{project.data.title}
												</a>
											) : (
												project.data.title
											)}
										</h3>
										<p class="mt-1 text-sm text-muted">
											{[
												project.data.year?.toString(),
												project.data.role,
												client,
												target?.external ? 'Live tool' : null,
											]
												.filter(Boolean)
												.join(' · ')}
										</p>
										<p class="mt-2 text-base">{project.data.summary}</p>
										{project.data.tools && (
											<p class="mt-2 text-sm text-muted">
												{project.data.tools.join(', ')}
											</p>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				</section>
			);
		})
	}
</Base>

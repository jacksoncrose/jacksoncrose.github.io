---
/*
  CV — the selected, client-facing curriculum vitae. Jackson's call
  2026-07-27: an HTML page only, no PDF download.

  Data comes from src/data/cv.json, which is GENERATED by
  _staging/cv/build/site-export.js from facts.js — the same fact file behind
  the resume and CV docx. Fix facts there and re-export; never hand-edit
  cv.json or hard-code facts into this page, or the web and document
  versions will drift. The export script's header comment lists what is
  deliberately excluded on the web (phone, working notes, the projects
  list, and service detail on any entry flagged webOmitDetail).

  The service-detail exclusion used to name MCSC specifically, held back
  while naming Sandfire Resources America on the public site was an open
  question. Jackson closed that on 2026-07-31 — name it everywhere — so the
  MCSC detail now renders here and no entry is flagged.
*/
import Base from '../layouts/Base.astro';
import cv from '../data/cv.json';
---

<Base
	title="CV"
	description="Curriculum vitae of Jackson C. Rose: appointments, education, certifications, publications, presentations, and service."
>
	<h1 class="text-4xl">Curriculum Vitae</h1>
	<p class="mt-3 text-sm text-muted">
		Selected CV, updated {cv.updated}. Project case studies are on the{' '}
		<a href="/projects">Projects</a> page.
	</p>

	<section class="mt-10">
		<h2 class="text-3xl">Professional Appointments</h2>
		<ul class="mt-5 space-y-9">
			{
				cv.appointments.map((a) => (
					<li>
						<p class="text-sm text-muted">{a.dates}</p>
						<h3 class="mt-1 text-xl">{a.title}</h3>
						<p class="text-base">
							{a.org} · {a.place}
						</p>
						<ul class="mt-3 list-disc space-y-1.5 pl-5 text-base">
							{a.bullets.map((b) => (
								<li>{b}</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Education</h2>
		<ul class="mt-5 space-y-6">
			{
				cv.education.map((e) => (
					<li>
						<p class="text-sm text-muted">{e.dates}</p>
						<p class="mt-1 text-base font-semibold">
							{e.school} · {e.place}
						</p>
						<p class="text-base">{e.degree}</p>
					</li>
				))
			}
		</ul>
	</section>

	{/*
		Grants added 2026-07-31, his call. Placed after Education and before
		Skills, matching the docx CV's order, because that is where an
		academic reader looks for it and three of the four awards are active.
		No dollar amounts anywhere, deliberately — see site-export.js.
	*/}
	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Grants and Funded Research</h2>
		<ul class="mt-5 space-y-6">
			{
				cv.grants.map((g) => (
					<li>
						<p class="text-sm text-muted">{g.dates}</p>
						<p class="mt-1 text-base font-semibold">{g.sponsor}</p>
						<p class="text-base">{g.title}</p>
						<p class="text-base text-muted">
							{g.role} · Principal Investigator: {g.pi}
						</p>
						{g.detail && <p class="mt-1 text-base">{g.detail}</p>}
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Technical Skills and Certifications</h2>
		<dl class="mt-5 space-y-4">
			{
				cv.skills.map((s) => (
					<div>
						<dt class="text-base font-semibold">{s.label}</dt>
						<dd class="text-base">{s.known}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Publications and Technical Reports</h2>
		<ul class="mt-5 space-y-5">
			{
				cv.publications.map((p) => (
					<li class="text-base">
						{p.year}. {p.text}
						{p.url && (
							<>
								{' '}
								<a href={p.url} aria-label={`Open: ${p.text}`}>
									Read
								</a>
							</>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Presentations</h2>
		<ul class="mt-5 space-y-6">
			{
				cv.presentations.map((t) => (
					<li>
						<p class="text-sm text-muted">{t.date}</p>
						<p class="mt-1 text-base">
							{t.role ?? 'Presenter'} · {t.venue}
						</p>
						{/*
							Where a session title exists it carries the italics and the
							workshop title becomes context beneath it. The session is the
							specific thing he did; the workshop is where it happened.
						*/}
						{t.session ? (
							<>
								<p class="text-base italic">{t.session}</p>
								<p class="text-base text-muted">Workshop: {t.title}</p>
							</>
						) : (
							<p class="text-base italic">{t.title}</p>
						)}
						{t.url && (
							<p class="text-base">
								<a href={t.url} aria-label={`Published proceedings: ${t.title}`}>
									Published proceedings
								</a>
							</p>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-12 border-t border-line pt-8">
		<h2 class="text-3xl">Professional Affiliations and Service</h2>
		<ul class="mt-5 space-y-6">
			{
				cv.service.map((s) => (
					<li>
						<p class="text-sm text-muted">{s.dates}</p>
						<p class="mt-1 text-base font-semibold">{s.org}</p>
						<p class="text-base">{s.role}</p>
						{s.detail && <p class="mt-1 text-base text-muted">{s.detail}</p>}
					</li>
				))
			}
		</ul>
	</section>
</Base>

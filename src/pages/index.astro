---
/*
  Home. Structure follows the settled sitemap in AGENTS.md:

    above the fold — name, roles (one compressed line), identity sentence,
                     one hero visual (a tax tool interface, NOT a point cloud),
                     contact
    below         — Tools strip, selected projects, technical-credibility band,
                    Maps teaser row

  Every piece of prose here is a TODO. The identity sentence in particular is
  written WITH Jackson and must not be autogenerated.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { getCollection } from 'astro:content';
import { published } from '../lib/content';
import { site } from '../site';

const projects = published(await getCollection('projects'));
const tools = published(await getCollection('tools'));
const gallery = published(await getCollection('gallery'));

/** Home shows the spine work: tier 1 first, capped at four cards. */
const selected = projects.filter((p) => p.data.tier === 1).slice(0, 4);
---

<Base title="Home" description="TODO: meta description, written with Jackson.">
	{/* ---------- above the fold ---------- */}
	<section>
		<h1 class="text-5xl">{site.name}</h1>
		<p class="mt-3 text-sm text-muted">{site.roles}</p>

		{
			site.identitySentence ? (
				<p class="mt-6 text-lg">{site.identitySentence}</p>
			) : (
				<Todo note="Identity sentence — one line on what Jackson builds and the unusual combination behind it. Written together, not autogenerated." />
			)
		}

		<Todo note="Hero visual: a tax-tool interface screenshot (not a point cloud). Needs the image file plus alt text describing what the tool shows." />
	</section>

	{/* ---------- tools strip ---------- */}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Tools</h2>
		{
			tools.length === 0 ? (
				<Todo note="No published tools yet. Each needs a title, two-sentence description, and a confirmed live URL." />
			) : (
				<ul class="mt-4 space-y-3">
					{tools.slice(0, 4).map((tool) => (
						<li>
							<span class="font-semibold">{tool.data.title}</span>
							<span class="text-muted"> — {tool.data.blurb}</span>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-4 text-sm"><a href="/tools">All tools</a></p>
	</section>

	{/* ---------- selected projects ---------- */}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Selected projects</h2>
		{
			selected.length === 0 ? (
				<Todo note="No published tier-1 projects yet: renewable energy tax calculators, Maine plant-to-TIF crosswalk, copper mine CBA, Montana rural typology PCA." />
			) : (
				<ul class="mt-4 space-y-6">
					{selected.map((project) => (
						<li>
							<h3 class="text-xl">
								{project.data.hasPage ? (
									<a href={`/projects/${project.id}`}>{project.data.title}</a>
								) : (
									project.data.title
								)}
							</h3>
							<p class="mt-1 text-base">{project.data.summary}</p>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-4 text-sm"><a href="/projects">All projects</a></p>
	</section>

	{/* ---------- technical credibility band ---------- */}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Data collection and processing</h2>
		<Todo note="Credibility band copy: UAS/LiDAR collection, photogrammetry, and processing — the layer that makes the tax tools unusual. Two or three sentences, plus the MSU campus LiDAR render as the below-fold visual." />
	</section>

	{/* ---------- maps teaser ---------- */}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Maps</h2>
		{
			gallery.length === 0 ? (
				<Todo note="Gallery inventory unconfirmed — which maps and figures go here is still an open question." />
			) : (
				<p class="mt-4 text-base">{gallery.length} entries in the gallery.</p>
			)
		}
		<p class="mt-4 text-sm"><a href="/maps">Map gallery</a></p>
	</section>
</Base>

---
/*
  Home. Structure (settled sitemap in AGENTS.md, amended 2026-07-30):

    above the fold — name, roles (one compressed line), identity sentence,
                     portrait photo (added 2026-07-29, Jackson's request),
                     contact — NO hero visual since 2026-07-30
    below         — Tools strip (cards), selected projects (cards),
                    Maps teaser row

  HERO REMOVED 2026-07-30 — Jackson's pick ("B — no hero") from four
  rendered options (keep estimator w/ better capture / no hero /
  federal-land choropleth / Rooney map banner) after he said he didn't
  love the estimator screenshot. The contour background and portrait
  carry the fold now; visual proof of work starts at the Tools cards.
  This supersedes the 2026-07-28 "hero is the estimator interface"
  decision. If a hero ever returns, it is his call — the runner-up was
  a tighter estimator capture (rows 7–10 images).

  The technical-credibility band ("Data collection and processing") was
  REMOVED at Jackson's request 2026-07-29 (it had been settled text-only
  earlier the same day; his call reversed it). Home no longer mentions
  UAS/LiDAR — that proof lives on the Projects page. Do not reintroduce
  the band without him.

  Every piece of prose here is a TODO. The identity sentence in particular is
  written WITH Jackson and must not be autogenerated.
*/
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { Image } from 'astro:assets';
import CardCover from '../components/CardCover.astro';
import { getCollection } from 'astro:content';
import { published, clientLabel, cardTarget } from '../lib/content';
import { site } from '../site';
import portraitImage from '../assets/images/jackson-rose-portrait.jpg';

const projects = published(await getCollection('projects'));
const tools = published(await getCollection('tools'));
const gallery = published(await getCollection('gallery'));

/**
 * Selected projects — an editorial pick, settled with Jackson 2026-07-28,
 * not a tier filter. The three tell one story in sequence: the
 * spatial-fiscal tool, community-side negotiation leadership, and the
 * national data layer built to power a fiscal tool. Entries render as they
 * become publishable (published() drops drafts), so this list is the
 * intent and the section grows into it:
 *
 *   1. renewable-energy-revenue-estimator — entry not yet created
 *   2. mcsc-community-benefits-agreement  — draft, body TODO
 *   3. national-land-ownership            — live
 *
 * Campus at Night is deliberately NOT here: UAS is secondary and does not
 * lead (AGENTS.md). It reaches Home through the Maps teaser instead.
 */
const selectedIds = [
	'renewable-energy-revenue-estimator',
	'mcsc-community-benefits-agreement',
	'national-land-ownership',
];
const selected = selectedIds
	.map((id) => projects.find((p) => p.id === id))
	.filter((p) => p !== undefined);

/**
 * Maps teaser — three thumbnails instead of a bare count (Jackson,
 * 2026-07-29). Picked for range across the three kinds of map work:
 * the national land-ownership choropleth, the overnight campus
 * orthomosaic, and a custom-hillshade ranch map. Swap ids to change
 * the picks; entries must exist in the gallery collection and not be
 * drafts, or the slot silently drops.
 */
const mapsTeaserIds = [
	'federal-land-share-2024',
	'msu-campus-lighting-2023',
	'rooney-north-hillshade',
];
const mapsTeaser = mapsTeaserIds
	.map((id) => gallery.find((g) => g.id === id))
	.filter((g) => g !== undefined);
---

<Base title="Home" description="Portfolio of Jackson Rose: geographer, Certified GIS Professional, and consultant on the community dimensions of energy and extractive development. Projects, maps, and tools.">
	{/*
	  The contour background (Bridger Range linework) MOVED to Base.astro
	  2026-07-30 when Jackson extended it from Home-only to every page.
	  Decision history and tuning knobs live with the markup there.
	*/}

	{/* ---------- above the fold ---------- */}
	<section>
		<div class="sm:flex sm:items-start sm:justify-between sm:gap-10">
			<div>
				<h1 class="text-5xl">{site.name}</h1>
				<p class="mt-3 text-sm text-muted">{site.roles}</p>

				{
					site.identitySentence ? (
						<p class="mt-6 text-lg">{site.identitySentence}</p>
					) : (
						<Todo note="Identity sentence — one line on what Jackson builds and the unusual combination behind it. Written together, not autogenerated." />
					)
				}

				{/*
				  Consulting line — SETTLED with Jackson 2026-07-30. He picked
				  the shortest of three drafted angles and cut one phrase: the
				  draft read "spatial analysis and survey", and he removed
				  "survey", which also keeps Home clear of UAS/LiDAR per the
				  standing rule that they never appear here.

				  Wording is his pick, verbatim — do not rewrite without him:
				  "Available for consulting: community benefits work, spatial
				  analysis, and tools that make the numbers usable."

				  Deliberately in his own voice with no vehicle named; the
				  RCRC partnership is explained on About, and the address here
				  is the consulting one. Jackson's scope call, same day: "This
				  portfolio site is not intended to drive work to the GCF."
				*/}
				{site.emailConsulting && (
					<p class="mt-5 border-l-2 border-accent pl-4 text-base">
						Available for consulting: community benefits work, spatial
						analysis, and tools that make the numbers usable.{' '}
						<a href={`mailto:${site.emailConsulting}`}>
							{site.emailConsulting}
						</a>
					</p>
				)}
			</div>
			<Image
				src={portraitImage}
				alt="Jackson Rose"
				widths={[176, 352, 528]}
				sizes="(min-width: 640px) 11rem, 10rem"
				loading="eager"
				class="mt-8 w-40 border border-line sm:mt-2 sm:w-44 sm:shrink-0"
			/>
		</div>

	</section>

	{/*
	  ---------- tools strip ----------
	  Cards + links settled with Jackson 2026-07-30 (rendered mockups, his
	  pick): tools render as linked cards with cover screenshots (the tools
	  schema gained an optional cover the same day). The whole card is
	  clickable via a stretched link (after:absolute after:inset-0) so the
	  accessible link text stays the tool title, not the entire card
	  contents. The "Home only" half of that decision was superseded later
	  the same day — the Tools index page now uses the same cards.

	  HORIZONTAL, ONE COLUMN since 2026-07-30 (Jackson: "make the cards more
	  square, less vertical"). They were a two-column grid with the image on
	  top, which measured 350×437 — decidedly portrait, because these blurbs
	  run long and all that text stacked under a 16:9 image. Image-left at
	  full width gives ~720×180 and matches the project cards below, so the
	  site now has one card shape instead of two. Alternatives built and
	  rejected: letterboxing the cover to 5:2 got the card to 0.92 but cost
	  Montana Hall its spire.
	*/}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Tools</h2>
		{
			tools.length === 0 ? (
				<Todo note="No published tools yet. Each needs a title, two-sentence description, and a confirmed live URL." />
			) : (
				<ul class="mt-6 grid gap-5">
					{tools.slice(0, 4).map((tool) => (
						<li class="relative border border-line bg-white transition-colors focus-within:border-accent hover:border-accent sm:flex">
							{tool.data.cover && (
								<CardCover src={tool.data.cover.src} alt={tool.data.cover.alt} />
							)}
							<div class="p-5">
								<h3 class="text-xl">
									{tool.data.url ? (
										<a href={tool.data.url} class="after:absolute after:inset-0">
											{tool.data.title}
										</a>
									) : (
										tool.data.title
									)}
								</h3>
								<p class="mt-1 text-sm text-muted">{tool.data.blurb}</p>
								{/* Lifted above the card's stretched link, same as on the
								    Tools page. */}
								{tool.data.caseStudy && (
									<p class="relative z-10 mt-2 text-sm">
										<a href={`/projects/${tool.data.caseStudy}`}>
											Read the case study
										</a>
									</p>
								)}
							</div>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-4 text-sm"><a href="/tools">All tools</a></p>
	</section>

	{/*
	  ---------- selected projects ----------
	  Card treatment settled with Jackson 2026-07-30 (rendered mockups, his
	  pick, Home only). Each entry is a bordered card; when a page exists the
	  whole card is clickable via a stretched link. The meta line is year +
	  client only — the role line stays on the Projects index, where there is
	  room for it (the MCSC role is a full sentence). Client names still pass
	  through clientLabel(), the single naming gate.

	  Small card image (AGENTS.md visual-hierarchy decision 2026-07-25):
	  tier-1 cards carry policy visuals so the page's image count favors the
	  primary work.

	  Image column widened 13rem → 16rem on 2026-07-30. The image has no
	  fixed aspect and stretches to card height, so at 13rem a landscape
	  photograph was being cropped to roughly 208×260 — a portrait slice of
	  a horizontal picture, which is what made the White Sulphur Springs
	  aerial look wrong here. At 16rem the crop lands near square and the
	  photograph survives it. If a future card's text runs much longer,
	  check this crop again rather than assuming it still holds.
	*/}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Selected projects</h2>
		{
			selected.length < selectedIds.length && (
				<Todo note="Selected-projects slots still pending: the renewable energy revenue estimator card (entry not yet created) and the MCSC community benefits agreement page (draft, body written with Jackson)." />
			)
		}
		{
			selected.length > 0 && (
				<ul class="mt-6 grid gap-5">
					{selected.map((project) => {
						const client = clientLabel(project.data);
						const target = cardTarget(project.data, project.id);
						const meta = [
							project.data.year?.toString(),
							client,
							/* Tells the reader the click leaves the site. Without it
							   an external card title looks identical to one that
							   opens a case study here. */
							target?.external ? 'Live tool' : null,
						]
							.filter(Boolean)
							.join(' · ');
						return (
							<li class="relative border border-line bg-white transition-colors focus-within:border-accent hover:border-accent sm:flex">
								{project.data.cover && (
									<CardCover
										src={project.data.cover.src}
										alt={project.data.cover.alt}
										fit={project.data.cover.fit}
									/>
								)}
								<div class="p-5">
									<h3 class="text-xl">
										{target ? (
											<a
												href={target.href}
												class="after:absolute after:inset-0"
											>
												{project.data.title}
											</a>
										) : (
											project.data.title
										)}
									</h3>
									{meta && <p class="mt-1 text-sm text-muted">{meta}</p>}
									<p class="mt-2 text-base">{project.data.summary}</p>
								</div>
							</li>
						);
					})}
				</ul>
			)
		}
		<p class="mt-4 text-sm"><a href="/projects">All projects</a></p>
	</section>

	{/* ---------- maps teaser ---------- */}
	<section class="mt-16 border-t border-line pt-8">
		<h2 class="text-3xl">Maps</h2>
		{
			mapsTeaser.length === 0 ? (
				<Todo note="Gallery inventory unconfirmed — which maps and figures go here is still an open question." />
			) : (
				<a
					href="/maps"
					aria-label={`Map gallery — ${gallery.length} maps`}
					class="mt-6 grid grid-cols-3 gap-4"
				>
					{mapsTeaser.map((entry) => (
						<Image
							src={entry.data.image}
							alt={entry.data.alt}
							widths={[240, 480, 720]}
							sizes="(min-width: 48rem) 20rem, 33vw"
							loading="lazy"
							class="aspect-[4/3] w-full border border-line bg-white object-cover"
						/>
					))}
				</a>
			)
		}
		<p class="mt-4 text-sm">
			<a href="/maps">All {gallery.length} maps in the gallery</a>
		</p>
	</section>
</Base>
